    /* Plant Growth Animation Keyframes */
    @keyframes sprout-grow {
      0% { transform: scale(0.3) translateY(30px); opacity: 0; }
      50% { transform: scale(1.1) translateY(-5px); opacity: 1; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }
    @keyframes pulse-glow {
      0%, 100% { opacity: 0.4; transform: scale(0.98); }
      50% { opacity: 0.8; transform: scale(1.03); }
    }
    @keyframes float-leaf {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-8px) rotate(6deg); }
    }

    .animate-sprout {
      animation: sprout-grow 1.2s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
