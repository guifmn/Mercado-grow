              <i data-lucide="user" className="w-5 h-5"></i>
              <span>Mais</span>
            </button>
          </nav>

        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
